; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Lost Utsav"
run/main_scene="res://scenes/ui/start_page.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

MusicManager="*res://scripts/music_manager.gd"
GameRunManager="*res://scripts/game_run_manager.gd"
SceneLoader="*res://scripts/ui/scene_loader.gd"
MobileControls="*res://scenes/ui/mobile_controls.tscn"
DynamicDifficultyManager="*res://scripts/dynamic_difficulty_manager.gd"

[display]

window/size/viewport_width=1020
window/size/viewport_height=720
window/size/window_width_override=1020
window/size/window_height_override=720
window/stretch/mode="viewport"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
