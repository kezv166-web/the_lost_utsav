[gd_scene format=3 uid="uid://speedrun_hud_overlay"]

[ext_resource type="Script" path="res://scripts/ui/speedrun_hud.gd" id="1_hud_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_hud"]
bg_color = Color(0.07, 0.05, 0.04, 0.88)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
